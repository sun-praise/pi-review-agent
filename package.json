{
  "name": "pi-review-agent",
  "version": "1.5.0",
  "description": "Multi-persona PR review agent on Pi with cross-runner session resume and correct cache_read accounting.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pi-review-agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "demo:cache": "tsx examples/demo-cache.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --experimental-test-module-mocks --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.0",
    "@earendil-works/pi-ai": "^0.80.0",
    "js-yaml": "^5.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0"
  }
}
